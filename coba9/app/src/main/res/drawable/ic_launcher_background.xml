<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Latar Belakang Gradasi Deep Slate / Navy -->
    <path
        android:pathData="M0,0h108v108H0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:offset="0.0" android:color="#0B132B" />
                <item android:offset="1.0" android:color="#1C2541" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Aksen Lingkaran Glow Cyan di Kanan Atas -->
    <path
        android:fillAlpha="0.25"
        android:pathData="M108,0 L60,0 A48,48 0 0,0 108,48 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="60"
                android:startY="0"
                android:endX="108"
                android:endY="48"
                android:type="linear">
                <item android:offset="0.0" android:color="#00F2FE" />
                <item android:offset="1.0" android:color="#0E7490" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Aksen Lingkaran Geometris Halus di Kiri Bawah -->
    <path
        android:fillAlpha="0.18"
        android:pathData="M0,60 A48,48 0 0,0 48,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="60"
                android:endX="48"
                android:endY="108"
                android:type="linear">
                <item android:offset="0.0" android:color="#2563EB" />
                <item android:offset="1.0" android:color="#0E7490" />
            </gradient>
        </aapt:attr>
    </path>
</vector>