<resources>
    <!-- 1. TEMA UNTUK SPLASH SCREEN (Modern Dark Navy Theme) -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Latar belakang Splash Screen senada dengan background icon -->
        <item name="windowSplashScreenBackground">#0B132B</item>
    
        <!-- Icon animasi / logo utama -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_logo_pos</item>
    
        <!-- Durasi animasi icon jika diperlukan -->
        <item name="windowSplashScreenAnimationDuration">500</item>
    
        <!-- Setelah Splash selesai, beralih ke tema utama -->
        <item name="postSplashScreenTheme">@style/Theme.SentralOrg</item>
    </style>

    <!-- 2. TEMA UTAMA APLIKASI -->
    <style name="Theme.SentralOrg" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#0284C7</item>
        <item name="colorSecondary">#0E7490</item>
        <item name="android:statusBarColor">#F4F5FB</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>