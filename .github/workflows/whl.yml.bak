name: Build Termux Wheel

on:
  workflow_dispatch:
    inputs:
      package_name:
        description: 'Nama paket Python di PyPI'
        required: true
        default: 'firecrawl-anydoc'

jobs:
  build:
    runs-on: ubuntu-24.04-arm

    steps:
      # 1. Cek Docker Image dari Cache
      - name: Cache Termux Builder Image
        id: cache-docker
        uses: actions/cache@v4
        with:
          path: /tmp/termux-builder.tar
          key: termux-builder-image-v25

      # 2. Build Image jika belum ada di cache
      - name: Siapkan Environment Termux Builder
        run: |
          if [ -f /tmp/termux-builder.tar ]; then
            echo "✅ Memuat Docker Termux dari cache..."
            docker load -i /tmp/termux-builder.tar
          else
            echo "⚙️ Membangun image Docker Termux baru..."
            docker build -t termux-builder:latest - << 'EOF'
            FROM termux/termux-docker:aarch64
            ENV ANDROID_API_LEVEL=24
            ENV RUSTFLAGS="-C lto=off"
            ENV CARGO_HOME=/data/data/com.termux/files/home/.cargo
            RUN pkg update -y && \
                pkg install -y python python-pip rust clang make binutils && \
                pip install --upgrade pip setuptools wheel maturin
          EOF
            echo "💾 Menyimpan image ke cache..."
            docker save termux-builder:latest -o /tmp/termux-builder.tar
          fi

      # 3. Siapkan folder dan buka izin akses (chmod 777 agar bebas Permission Denied)
      - name: Siapkan folder & izin akses
        run: |
          mkdir -p dist cargo-cache pip-cache
          chmod -R 777 dist cargo-cache pip-cache

      # 4. Cache untuk crate Rust & Pip
      - name: Cache Rust Crates & Pip Downloads
        uses: actions/cache@v4
        with:
          path: |
            cargo-cache
            pip-cache
          key: cargo-pip-cache-${{ inputs.package_name }}
          restore-keys: |
            cargo-pip-cache-

      # 5. Build Wheel dengan --no-build-isolation
      - name: Build Wheel
        run: |
          # Pastikan izin tetap terbuka setelah cache di-restore
          chmod -R 777 dist cargo-cache pip-cache

          docker run --rm \
            -e ANDROID_API_LEVEL=24 \
            -e RUSTFLAGS="-C lto=off" \
            -e CARGO_HOME=/data/data/com.termux/files/home/.cargo \
            -v ${{ github.workspace }}/dist:/dist \
            -v ${{ github.workspace }}/cargo-cache:/data/data/com.termux/files/home/.cargo \
            -v ${{ github.workspace }}/pip-cache:/data/data/com.termux/files/home/.cache/pip \
            termux-builder:latest \
            sh -c "
              set -e
              pip wheel --no-build-isolation --no-deps -w /dist '${{ inputs.package_name }}'
            "

      # 6. Upload hasil *.whl
      - name: Upload Artifact (*.whl)
        uses: actions/upload-artifact@v4
        with:
          name: termux-${{ inputs.package_name }}-wheel
          path: dist/*.whl