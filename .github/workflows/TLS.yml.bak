name: Build tls-client-node Native for Termux ARM64

on:
  workflow_dispatch:

jobs:
  build-tls-client:
    runs-on: ubuntu-24.04-arm

    steps:
      - name: Create output directory
        run: |
          mkdir -p output
          chmod 777 output

      - name: Build Go TLS-Client & Setup Koffi inside Termux Docker
        run: |
          docker run --rm --privileged \
            -v "${{ github.workspace }}/output:/output" \
            ghcr.io/termux-user-repository/termux-docker:aarch64 \
            bash -c "
              set -e
              export DEBIAN_FRONTEND=noninteractive

              echo '=== 1. Install Golang & System Tools ==='
              apt update
              apt -y -o Dpkg::Options::=\"--force-confnew\" full-upgrade
              apt install -yq -o Dpkg::Options::=\"--force-confnew\" nodejs golang git python make clang binutils build-essential libc++

              # Bersihkan foreground-scripts npm
              npm config delete foreground-scripts || true

              echo '=== 2. Compile Go tls-client .so untuk Android Bionic ==='
              mkdir -p /data/data/com.termux/files/home/build
              cd /data/data/com.termux/files/home/build
              git clone --depth 1 https://github.com/bogdanfinn/tls-client.git
              cd tls-client/cffi_dist
              CGO_ENABLED=1 go build -buildmode=c-shared -o tls-client-arm64.so main.go
              ls -lh tls-client-arm64.so

              echo '=== 3. Install Koffi, tls-client-node & tough-cookie ==='
              cd /data/data/com.termux/files/home/build
              npm init -y
              npm install koffi tls-client-node tough-cookie --ignore-scripts

              echo '=== 4. Setup & Patch Koffi untuk Android ARM64 ==='
              cd node_modules/koffi
              # Buat target direktori android_arm64 dan salin binary prebuilt
              mkdir -p build/koffi/android_arm64 build/Release
              cp -f build/koffi/linux_arm64/koffi.node build/koffi/android_arm64/koffi.node
              cp -f build/koffi/linux_arm64/koffi.node build/Release/koffi.node

              # Patch loader koffi agar mengenali android
              find . -name '*.js' -o -name '*.mjs' -o -name '*.cjs' | while read -r f; do
                sed -i 's/process\.platform === .linux./(process.platform === \"linux\" || process.platform === \"android\")/g' \"\$f\"
                sed -i 's/case .linux.:/case \"linux\":\ncase \"android\":/g' \"\$f\"
              done
              cd /data/data/com.termux/files/home/build

              echo '=== 5. Setup & Patch tls-client-node ==='
              mkdir -p node_modules/tls-client-node/dist/bin node_modules/tls-client-node/bin
              find node_modules/tls-client-node -name \"tls-client-linux-arm64*.so\" -exec cp -f /data/data/com.termux/files/home/build/tls-client/cffi_dist/tls-client-arm64.so {} \;
              cp -f /data/data/com.termux/files/home/build/tls-client/cffi_dist/tls-client-arm64.so node_modules/tls-client-node/dist/bin/tls-client-linux-arm64.so || true
              cp -f /data/data/com.termux/files/home/build/tls-client/cffi_dist/tls-client-arm64.so node_modules/tls-client-node/bin/tls-client-linux-arm64.so || true

              # Patch check platform di tls-client-node
              find node_modules/tls-client-node -name '*.js' | while read -r f; do
                sed -i 's/process\.platform === .linux./(process.platform === \"linux\" || process.platform === \"android\")/g' \"\$f\"
                sed -i 's/case .linux.:/case \"linux\":\ncase \"android\":/g' \"\$f\"
              done

              echo '=== 6. Uji Coba Module Lengkap di Node.js ==='
              node -e \"
                const koffi = require('./node_modules/koffi');
                console.log('✅ 1. Koffi native module OK!');
                const { TLSClient } = require('./node_modules/tls-client-node');
                const client = new TLSClient();
                console.log('✅ 2. TLSClient native engine OK!');
              \"

              echo '=== 7. Mengarsipkan Paket Lengkap ==='
              tar --hard-dereference -czvf /output/tls-client-termux-aarch64.tar.gz -C node_modules tls-client-node koffi tough-cookie
              echo '=== Build Selesai! ==='
            "

      - name: Upload Build Artifact
        uses: actions/upload-artifact@v4
        with:
          name: tls-client-termux-aarch64
          path: output/tls-client-termux-aarch64.tar.gz
          retention-days: 7