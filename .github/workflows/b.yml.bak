name: Build Patched Primp for Termux Android

on:
  workflow_dispatch:
    inputs:
      primp_version:
        description: 'Primp git tag/branch (default: main)'
        required: false
        default: 'main'
  push:
    tags:
      - 'v*'

jobs:
  build-wheels:
    name: Build Android Wheel (${{ matrix.target }})
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false # Jangan batalkan target lain jika salah satu gagal
      matrix:
        target:
          - aarch64-linux-android
          - armv7-linux-androideabi

    steps:
      - name: Checkout Workflow Repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Install Maturin
        run: |
          pip install --upgrade pip maturin

      - name: Set up Rust Toolchain
        uses: dtolnay/rust-toolchain@stable
        with:
          targets: ${{ matrix.target }}

      - name: Set up Android NDK
        uses: nttld/setup-ndk@v1
        with:
          ndk-version: r26d
          add-to-path: true

      - name: Clone Upstream Primp
        run: |
          git clone https://github.com/deedy5/primp.git primp-src
          cd primp-src
          if [ "${{ github.event.inputs.primp_version }}" != "main" ] && [ -n "${{ github.event.inputs.primp_version }}" ]; then
            git checkout ${{ github.event.inputs.primp_version }} || true
          fi

      - name: Vendor & Patch Crates (Bypass ndk-context / Android JNI)
        run: |
          cd primp-src
          mkdir -p .cargo
          cargo vendor > .cargo/config.toml

          python3 -c '
          import os, json

          print("===> Mem-patch crate rustls-platform-verifier & ndk-context...")
          for root, dirs, files in os.walk("vendor"):
              if any(k in root for k in ["rustls-platform-verifier", "ndk-context"]):
                  for file in files:
                      if file.endswith((".rs", ".toml")):
                          filepath = os.path.join(root, file)
                          with open(filepath, "r", encoding="utf-8", errors="ignore") as f:
                              content = f.read()
                          new_content = content.replace("target_os = \"android\"", "target_os = \"disabled_android\"").replace("\"android\"", "\"disabled_android\"")
                          if new_content != content:
                              with open(filepath, "w", encoding="utf-8") as f:
                                  f.write(new_content)

          print("===> Menghapus validasi checksum Cargo...")
          for root, dirs, files in os.walk("vendor"):
              if ".cargo-checksum.json" in files:
                  filepath = os.path.join(root, ".cargo-checksum.json")
                  try:
                      with open(filepath, "r", encoding="utf-8") as f:
                          data = json.load(f)
                      data["files"] = {}
                      with open(filepath, "w", encoding="utf-8") as f:
                          json.dump(data, f)
                  except Exception as e:
                      print(f"Error resetting {filepath}: {e}")

          print("Patching & reset checksum selesai!")
          '

      - name: Compile Wheel with Maturin
        run: |
          export ANDROID_NDK_HOME=$ANDROID_NDK_ROOT
          export ANDROID_API_LEVEL=24
          TOOLCHAIN=$ANDROID_NDK_HOME/toolchains/llvm/prebuilt/linux-x86_64
          export PATH=$TOOLCHAIN/bin:$PATH

          # Buat direktori stub libpython3.so untuk linker NDK
          STUB_DIR=/tmp/python_stubs
          mkdir -p "$STUB_DIR"

          if [ "${{ matrix.target }}" = "aarch64-linux-android" ]; then
            export CC_aarch64_linux_android=$TOOLCHAIN/bin/aarch64-linux-android24-clang
            export CXX_aarch64_linux_android=$TOOLCHAIN/bin/aarch64-linux-android24-clang++
            export CARGO_TARGET_AARCH64_LINUX_ANDROID_LINKER=$TOOLCHAIN/bin/aarch64-linux-android24-clang
            export CARGO_TARGET_AARCH64_LINUX_ANDROID_AR=$TOOLCHAIN/bin/llvm-ar
            $TOOLCHAIN/bin/aarch64-linux-android24-clang -shared -o "$STUB_DIR/libpython3.so" -x c /dev/null
          elif [ "${{ matrix.target }}" = "armv7-linux-androideabi" ]; then
            export CC_armv7_linux_androideabi=$TOOLCHAIN/bin/armv7a-linux-androideabi24-clang
            export CXX_armv7_linux_androideabi=$TOOLCHAIN/bin/armv7a-linux-androideabi24-clang++
            export CARGO_TARGET_ARMV7_LINUX_ANDROIDEABI_LINKER=$TOOLCHAIN/bin/armv7a-linux-androideabi24-clang
            export CARGO_TARGET_ARMV7_LINUX_ANDROIDEABI_AR=$TOOLCHAIN/bin/llvm-ar
            $TOOLCHAIN/bin/armv7a-linux-androideabi24-clang -shared -o "$STUB_DIR/libpython3.so" -x c /dev/null
          fi

          for v in 3.8 3.9 3.10 3.11 3.12 3.13 3.14; do
            ln -sf libpython3.so "$STUB_DIR/libpython$v.so"
          done

          export LIBRARY_PATH="$STUB_DIR:$LIBRARY_PATH"
          export RUSTFLAGS="-L $STUB_DIR"

          mkdir -p dist
          cd primp-src/crates/primp-python
          maturin build --release --target ${{ matrix.target }} --out ../../../dist --strip

          cd ../../../dist
          echo "=== Hasil Build Wheel ==="
          ls -la

          # Duplikasi platform tag linux_* agar langsung dikenali oleh pip di Termux
          for f in *.whl; do
            if [[ "$f" == *"arm64_v8a"* ]] || [[ "$f" == *"aarch64"* ]]; then
              new_name=$(echo "$f" | sed -E 's/android_[0-9]+_arm64_v8a/linux_aarch64/g' | sed 's/android_aarch64/linux_aarch64/g')
              [ "$f" != "$new_name" ] && cp "$f" "$new_name"
            elif [[ "$f" == *"armeabi_v7a"* ]] || [[ "$f" == *"armv7"* ]]; then
              new_name=$(echo "$f" | sed -E 's/android_[0-9]+_armeabi_v7a/linux_armv7l/g' | sed 's/android_armv7/linux_armv7l/g')
              [ "$f" != "$new_name" ] && cp "$f" "$new_name"
            fi
          done

          echo "=== Daftar Wheel Akhir ==="
          ls -la

      - name: Upload Artifact
        uses: actions/upload-artifact@v4
        with:
          name: primp-termux-${{ matrix.target }}
          path: dist/*.whl

      - name: Create Release on Tag
        if: startsWith(github.ref, 'refs/tags/')
        uses: softprops/action-gh-release@v2
        with:
          files: dist/*.whl