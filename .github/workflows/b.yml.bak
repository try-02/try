name: Build Patched Primp for Termux Android

on:
  workflow_dispatch:
    inputs:
      primp_ref:
        description: "Primp tag/branch/commit"
        required: false
        default: "v2.0.0"
  push:
    tags:
      - "v*"

permissions:
  contents: write

jobs:
  build-wheels:
    name: Build Termux wheel (${{ matrix.target }})
    runs-on: ubuntu-latest

    strategy:
      fail-fast: false
      matrix:
        target:
          - aarch64-linux-android
          - armv7-linux-androideabi

    env:
      ANDROID_API_LEVEL: "24"
      PIP_DISABLE_PIP_VERSION_CHECK: "1"
      PYTHONUNBUFFERED: "1"

    steps:
      - name: Checkout workflow repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Install build tools
        run: |
          python -m pip install --upgrade pip setuptools wheel
          python -m pip install maturin

      - name: Set up Rust
        uses: dtolnay/rust-toolchain@stable
        with:
          targets: ${{ matrix.target }}

      - name: Set up Android NDK
        uses: nttld/setup-ndk@v1
        with:
          ndk-version: r26d
          add-to-path: true

      - name: Clone Primp
        shell: bash
        env:
          PRIMP_REF: ${{ github.event.inputs.primp_ref }}
        run: |
          set -euxo pipefail

          REF="${PRIMP_REF:-v2.0.0}"

          git clone https://github.com/deedy5/primp.git primp-src
          cd primp-src

          git checkout "$REF"

          echo "=== Primp revision ==="
          git rev-parse HEAD
          git describe --tags --always || true

      - name: Inspect original dependency features
        shell: bash
        run: |
          set -euxo pipefail
          cd primp-src

          echo "=== primp-python Cargo.toml ==="
          sed -n '1,240p' crates/primp-python/Cargo.toml

          echo "=== workspace Cargo.toml ==="
          sed -n '1,260p' Cargo.toml

      - name: Vendor crates
        shell: bash
        run: |
          set -euxo pipefail
          cd primp-src

          mkdir -p .cargo

          cargo vendor > .cargo/config.toml

          echo "=== Vendor selesai ==="
          test -d vendor
          test -f .cargo/config.toml

      - name: Patch for Termux
        shell: bash
        run: |
          set -euxo pipefail
          cd primp-src

          python3 <<'PY'
          import json
          import os
          from pathlib import Path

          ROOT = Path(".")

          def read(path: Path) -> str:
              return path.read_text(encoding="utf-8")

          def write(path: Path, text: str) -> None:
              path.write_text(text, encoding="utf-8")

          print("====================================================")
          print("1. Disable primp-python hickory-dns feature")
          print("====================================================")

          candidates = [
              ROOT / "crates/primp-python/Cargo.toml",
              ROOT / "Cargo.toml",
          ]

          found_python_manifest = False

          for path in candidates:
              if not path.exists():
                  continue

              text = read(path)

              if path.name == "Cargo.toml" and "crates/primp-python" in str(path):
                  found_python_manifest = True

              original = text

              # Remove a literal feature entry:
              #   "hickory-dns",
              # or:
              #   "hickory-dns"
              text = text.replace('    "hickory-dns",\n', "")
              text = text.replace('    "hickory-dns"\n', "")

              if "hickory-dns" in original and text != original:
                  print(f"Patched feature list: {path}")

              write(path, text)

          if not found_python_manifest and not (ROOT / "crates/primp-python/Cargo.toml").exists():
              raise SystemExit("ERROR: crates/primp-python/Cargo.toml tidak ditemukan")

          print()
          print("====================================================")
          print("2. Patch rustls-platform-verifier untuk Termux")
          print("====================================================")

          verifier_dirs = sorted(
              p for p in (ROOT / "vendor").glob("rustls-platform-verifier-*")
              if p.is_dir() and "android" not in p.name
          )

          if not verifier_dirs:
              raise SystemExit(
                  "ERROR: vendor/rustls-platform-verifier-* tidak ditemukan"
              )

          for verifier in verifier_dirs:
              print(f"Processing: {verifier}")

              cargo_toml = verifier / "Cargo.toml"

              if cargo_toml.exists():
                  text = read(cargo_toml)

                  # Disable Android-specific conditionals.
                  text = text.replace(
                      'target_os = "android"',
                      'target_os = "disabled_android"',
                  )
                  text = text.replace(
                      'not(target_os = "android")',
                      'not(target_os = "disabled_android")',
                  )

                  write(cargo_toml, text)

              verification_dir = verifier / "src" / "verification"
              others = verification_dir / "others.rs"
              android = verification_dir / "android.rs"
              mod_rs = verification_dir / "mod.rs"
              lib_rs = verifier / "src" / "lib.rs"

              if others.exists():
                  others_text = read(others)

                  others_text = others_text.replace(
                      'target_os = "android"',
                      'target_os = "disabled_android"',
                  )
                  others_text = others_text.replace(
                      'not(target_os = "android")',
                      'not(target_os = "disabled_android")',
                  )

                  write(others, others_text)

                  # On Termux we want the Unix implementation.
                  write(android, others_text)

              # Force the generic verifier implementation.
              if mod_rs.exists():
                  write(
                      mod_rs,
                      "mod others;\n"
                      "pub use others::*;\n"
                  )

              if lib_rs.exists():
                  text = read(lib_rs)

                  text = text.replace(
                      'target_os = "android"',
                      'target_os = "disabled_android"',
                  )

                  text = text.replace(
                      "pub mod android;",
                      "// pub mod android;",
                  )

                  write(lib_rs, text)

          print()
          print("====================================================")
          print("3. Reset vendor checksums after source patching")
          print("====================================================")

          count = 0

          for checksum in (ROOT / "vendor").rglob(".cargo-checksum.json"):
              try:
                  data = json.loads(read(checksum))
                  data["files"] = {}
                  write(
                      checksum,
                      json.dumps(data, separators=(",", ":")),
                  )
                  count += 1
              except Exception as exc:
                  raise SystemExit(
                      f"Gagal patch checksum {checksum}: {exc}"
                  )

          print(f"Checksum patched: {count} files")

          print()
          print("====================================================")
          print("PATCH SELESAI")
          print("====================================================")
          PY

      - name: Validate Cargo manifests after patch
        shell: bash
        run: |
          set -euxo pipefail
          cd primp-src

          cargo metadata \
            --format-version 1 \
            --no-deps \
            --target "${{ matrix.target }}" \
            > /tmp/primp-metadata.json

          echo "Cargo metadata OK."

      - name: Verify no Android Context dependency remains
        shell: bash
        run: |
          set -euxo pipefail
          cd primp-src

          echo "===================================================="
          echo "cargo tree -i ndk-context"
          echo "===================================================="

          set +e
          TREE_OUTPUT="$(
            cargo tree \
              --target "${{ matrix.target }}" \
              -i ndk-context \
              2>&1
          )"
          TREE_STATUS=$?
          set -e

          echo "$TREE_OUTPUT"

          if echo "$TREE_OUTPUT" | grep -q "ndk-context"; then
            echo
            echo "ERROR: ndk-context masih masuk ke dependency tree."
            echo
            exit 1
          fi

          # Cargo returns non-zero when a package cannot be found as a dependency.
          # That is exactly what we expect here.
          if [ "$TREE_STATUS" -ne 0 ]; then
            echo
            echo "OK: ndk-context tidak menjadi dependency untuk target ${{ matrix.target }}."
          else
            echo
            echo "ERROR: cargo tree menemukan ndk-context."
            exit 1
          fi

      - name: Audit dependency features
        shell: bash
        run: |
          set -euxo pipefail
          cd primp-src

          echo "===================================================="
          echo "Dependency audit"
          echo "===================================================="

          cargo tree \
            --target "${{ matrix.target }}" \
            -e features \
            > /tmp/primp-feature-tree.txt

          if grep -Eiq 'hickory-dns|hickory-resolver' /tmp/primp-feature-tree.txt; then
            echo "ERROR: Hickory DNS masih terdapat pada feature tree."
            grep -Ei 'hickory-dns|hickory-resolver' /tmp/primp-feature-tree.txt || true
            exit 1
          fi

          echo "OK: Hickory DNS tidak aktif."

          if grep -Eiq 'rustls-platform-verifier-android|ndk-context' \
            /tmp/primp-feature-tree.txt; then
            echo "ERROR: Android verifier / ndk-context masih ditemukan."
            grep -Ei \
              'rustls-platform-verifier-android|ndk-context' \
              /tmp/primp-feature-tree.txt || true
            exit 1
          fi

          echo "OK: Android verifier dependency tidak ditemukan."

      - name: Configure Android linker
        shell: bash
        run: |
          set -euxo pipefail

          export TOOLCHAIN="$ANDROID_NDK_ROOT/toolchains/llvm/prebuilt/linux-x86_64"

          case "${{ matrix.target }}" in
            aarch64-linux-android)
              export CC_aarch64_linux_android="$TOOLCHAIN/bin/aarch64-linux-android${ANDROID_API_LEVEL}-clang"
              export CXX_aarch64_linux_android="$TOOLCHAIN/bin/aarch64-linux-android${ANDROID_API_LEVEL}-clang++"
              export CARGO_TARGET_AARCH64_LINUX_ANDROID_LINKER="$TOOLCHAIN/bin/aarch64-linux-android${ANDROID_API_LEVEL}-clang"
              ;;
            armv7-linux-androideabi)
              export CC_armv7_linux_androideabi="$TOOLCHAIN/bin/armv7a-linux-androideabi${ANDROID_API_LEVEL}-clang"
              export CXX_armv7_linux_androideabi="$TOOLCHAIN/bin/armv7a-linux-androideabi${ANDROID_API_LEVEL}-clang++"
              export CARGO_TARGET_ARMV7_LINUX_ANDROIDEABI_LINKER="$TOOLCHAIN/bin/armv7a-linux-androideabi${ANDROID_API_LEVEL}-clang"
              ;;
            *)
              echo "Unsupported target"
              exit 1
              ;;
          esac

          echo "PATH=$TOOLCHAIN/bin:$PATH" >> "$GITHUB_ENV"
          echo "ANDROID_NDK_HOME=$ANDROID_NDK_ROOT" >> "$GITHUB_ENV"

          echo "CC_aarch64_linux_android=$CC_aarch64_linux_android" >> "$GITHUB_ENV" || true
          echo "CXX_aarch64_linux_android=$CXX_aarch64_linux_android" >> "$GITHUB_ENV" || true
          echo "CARGO_TARGET_AARCH64_LINUX_ANDROID_LINKER=$CARGO_TARGET_AARCH64_LINUX_ANDROID_LINKER" >> "$GITHUB_ENV" || true

          echo "CC_armv7_linux_androideabi=$CC_armv7_linux_androideabi" >> "$GITHUB_ENV" || true
          echo "CXX_armv7_linux_androideabi=$CXX_armv7_linux_androideabi" >> "$GITHUB_ENV" || true
          echo "CARGO_TARGET_ARMV7_LINUX_ANDROIDEABI_LINKER=$CARGO_TARGET_ARMV7_LINUX_ANDROIDEABI_LINKER" >> "$GITHUB_ENV" || true

          echo "=== Android environment ==="
          echo "ANDROID_NDK_ROOT=$ANDROID_NDK_ROOT"
          echo "ANDROID_API_LEVEL=$ANDROID_API_LEVEL"
          echo "TARGET=${{ matrix.target }}"

      - name: Prepare Python linker stub
        shell: bash
        run: |
          set -euxo pipefail

          STUB_DIR="$RUNNER_TEMP/python-stubs"
          mkdir -p "$STUB_DIR"

          case "${{ matrix.target }}" in
            aarch64-linux-android)
              "$ANDROID_NDK_ROOT/toolchains/llvm/prebuilt/linux-x86_64/bin/aarch64-linux-android${ANDROID_API_LEVEL}-clang" \
                -shared \
                -o "$STUB_DIR/libpython3.so" \
                -x c /dev/null
              ;;
            armv7-linux-androideabi)
              "$ANDROID_NDK_ROOT/toolchains/llvm/prebuilt/linux-x86_64/bin/armv7a-linux-androideabi${ANDROID_API_LEVEL}-clang" \
                -shared \
                -o "$STUB_DIR/libpython3.so" \
                -x c /dev/null
              ;;
          esac

          for v in 3.8 3.9 3.10 3.11 3.12 3.13 3.14; do
            ln -sf libpython3.so "$STUB_DIR/libpython$v.so"
          done

          echo "PRIMP_PYTHON_STUB_DIR=$STUB_DIR" >> "$GITHUB_ENV"
          echo "LIBRARY_PATH=$STUB_DIR:${LIBRARY_PATH:-}" >> "$GITHUB_ENV"
          echo "RUSTFLAGS=-L $STUB_DIR" >> "$GITHUB_ENV"

      - name: Build wheel
        shell: bash
        run: |
          set -euxo pipefail

          mkdir -p dist

          cd primp-src/crates/primp-python

          maturin build \
            --release \
            --target "${{ matrix.target }}" \
            --out ../../../dist \
            --strip

          cd ../../../

          echo "===================================================="
          echo "Built wheels"
          echo "===================================================="

          ls -lah dist
          test -n "$(find dist -maxdepth 1 -name '*.whl' -print -quit)"

      - name: Validate wheel structure
        shell: bash
        run: |
          set -euxo pipefail

          python -m pip install --upgrade wheel

          for WHL in dist/*.whl; do
            echo
            echo "===================================================="
            echo "Checking: $WHL"
            echo "===================================================="

            python -m wheel unpack "$WHL" -d /tmp/wheel-check

            UNPACKED="$(find /tmp/wheel-check -mindepth 1 -maxdepth 1 -type d | tail -n 1)"

            test -n "$UNPACKED"

            echo "Wheel metadata:"
            sed -n '1,220p' "$UNPACKED"/*.dist-info/WHEEL

            echo
            echo "RECORD:"
            test -f "$UNPACKED"/*.dist-info/RECORD

            echo
            echo "Native files:"
            find "$UNPACKED" -type f \
              \( -name '*.so' -o -name '*.abi3.so' \) \
              -print

            test -n "$(
              find "$UNPACKED" -type f \
                \( -name '*.so' -o -name '*.abi3.so' \) \
                -print -quit
            )"

            rm -rf /tmp/wheel-check/*
          done

      - name: Validate wheel filename and architecture
        shell: bash
        run: |
          set -euxo pipefail

          case "${{ matrix.target }}" in
            aarch64-linux-android)
              EXPECTED="aarch64"
              ;;
            armv7-linux-androideabi)
              EXPECTED="armv7"
              ;;
          esac

          echo "Expected architecture marker: $EXPECTED"

          for WHL in dist/*.whl; do
            echo "Wheel: $(basename "$WHL")"

            case "$WHL" in
              *"$EXPECTED"*) ;;
              *)
                echo "WARNING: architecture marker tidak muncul pada filename wheel."
                ;;
            esac
          done

      - name: Run static import smoke test against built artifact
        shell: bash
        run: |
          set -euxo pipefail

          python -m pip install --force-reinstall dist/*.whl --no-deps

          python - <<'PY'
          import primp

          print("Primp import OK")
          print("Version:", getattr(primp, "__version__", "unknown"))
          PY

      - name: Publish artifact
        uses: actions/upload-artifact@v4
        with:
          name: primp-termux-${{ matrix.target }}
          path: dist/*.whl
          if-no-files-found: error

      - name: Create GitHub Release
        if: startsWith(github.ref, 'refs/tags/')
        uses: softprops/action-gh-release@v2
        with:
          files: dist/*.whl
          fail_on_unmatched_files: true