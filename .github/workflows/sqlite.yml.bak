name: Optimized Build better-sqlite3 (Termux ARM64)

on:
  workflow_dispatch:
    inputs:
      node_package:
        description: 'Pilih paket Node.js di Termux'
        required: true
        default: 'nodejs'
        type: choice
        options:
          - nodejs
          - nodejs-lts
      sqlite_version:
        description: 'Versi better-sqlite3'
        required: true
        default: 'latest'

jobs:
  build-arm64:
    runs-on: ubuntu-24.04-arm

    steps:
      - name: Create output directory
        run: |
          mkdir -p output
          chmod 777 output

      - name: Build better-sqlite3 inside Official Termux Docker
        run: |
          docker run --rm --privileged \
            -v "${{ github.workspace }}/output:/output" \
            ghcr.io/termux-user-repository/termux-docker:aarch64 \
            bash -c "
              set -e
              echo '=== 1. Install Compiler & Dependensi ==='
              apt update && apt install -yq ${{ inputs.node_package }} python make clang binutils build-essential

              # Bersihkan config foreground-scripts sesuai rekomendasi npm Termux
              npm config delete foreground-scripts || true

              echo '=== 2. Versi Node & NPM ==='
              node -v
              npm -v

              echo '=== 3. Unduh Package better-sqlite3 ==='
              mkdir -p /data/data/com.termux/files/home/build
              cd /data/data/com.termux/files/home/build
              npm init -y
              npm install better-sqlite3@${{ inputs.sqlite_version }} --ignore-scripts

              echo '=== 4. Kompilasi C++ Native Module ==='
              cd node_modules/better-sqlite3
              npm run build-release

              echo '=== 5. Uji Coba Modul di Node.js ==='
              node -e \"const Database = require('.'); console.log('SUCCESS: better-sqlite3 berhasil di-load!');\"

              echo '=== 6. Verifikasi File Binary ==='
              ls -la build/Release/better_sqlite3.node

              echo '=== 7. Mengarsipkan Modul ==='
              cd /data/data/com.termux/files/home/build
              tar -czvf /output/better-sqlite3-termux-aarch64.tar.gz -C node_modules better-sqlite3
              echo '=== Build Selesai! ==='
            "

      - name: Upload Build Artifact
        uses: actions/upload-artifact@v4
        with:
          name: better-sqlite3-termux-aarch64
          path: output/better-sqlite3-termux-aarch64.tar.gz
          retention-days: 1