name: Optimized Build better-sqlite3 (Termux ARM64)

on:
  workflow_dispatch:
    inputs:
      node_package:
        description: 'Pilih paket Node.js di Termux'
        required: true
        default: 'nodejs-lts'
        type: choice
        options:
          - nodejs-lts
          - nodejs
      sqlite_version:
        description: 'Versi better-sqlite3'
        required: true
        default: 'latest'

jobs:
  build-arm64:
    # OPSI 1: Runner Native ARM64 GitHub (Gratis untuk Repo Public) -> 'ubuntu-24.04-arm'
    # OPSI 2: Runner Namespace -> 'namespace-profile-default'
    runs-on: ubuntu-24.04-arm

    steps:
      - name: Create output directory
        run: |
          mkdir -p output
          chmod 777 output

      - name: Build better-sqlite3 inside Termux Container
        run: |
          docker run --rm --privileged \
            -v "${{ github.workspace }}/output:/output" \
            termux/termux-docker:aarch64 \
            bash -c "
              set -e
              echo '=== Update Repository & Install Tools ==='
              pkg update -y
              pkg install -y ${{ inputs.node_package }} python make clang build-essential

              echo '=== Node & NPM Version ==='
              node -v
              npm -v

              echo '=== Compile better-sqlite3 ==='
              mkdir -p /data/data/com.termux/files/home/build
              cd /data/data/com.termux/files/home/build
              npm init -y
              npm install better-sqlite3@${{ inputs.sqlite_version }} --build-from-source

              echo '=== Verifikasi Binary .node ==='
              ls -la node_modules/better-sqlite3/build/Release/better_sqlite3.node

              echo '=== Mengarsipkan Modul ==='
              tar -czvf /output/better-sqlite3-termux-aarch64.tar.gz -C node_modules better-sqlite3
              echo '=== Build Selesai! ==='
            "

      - name: Upload Build Artifact
        uses: actions/upload-artifact@v4
        with:
          name: better-sqlite3-termux-aarch64
          path: output/better-sqlite3-termux-aarch64.tar.gz
          retention-days: 7